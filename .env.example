# URL base de la API. En desarrollo "/api": Vite la reenvía a BACKEND_URL (sin CORS).
# En producción pon la URL pública del BackEnd, p. ej. https://api.milenew.co/api
VITE_API_URL=/api

# Solo para el proxy de desarrollo de Vite (no llega al navegador)
BACKEND_URL=http://localhost:5000

# Site key de Google reCAPTCHA v2 en modo INVISIBLE (el control "No soy un robot" lo dibuja la app).
# En producción, registra la clave como tipo "Invisible reCAPTCHA".
# Esta es la clave de PRUEBA oficial de Google (siempre aprueba, muestra un aviso):
# úsala solo en desarrollo, junto con su secreto de prueba en backend/.env.
# Para producción registra el dominio real en https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI

# IMPORTANTE: nunca pongas credenciales de PostgreSQL aquí.
# Todo lo que empieza por VITE_ termina dentro del JavaScript público.

# Correo de contacto que aparece en la política de datos y los términos (opcional)
VITE_CONTACT_EMAIL=
