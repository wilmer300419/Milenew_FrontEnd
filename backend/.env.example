# ---------------- Flask ----------------
FLASK_APP=run.py
FLASK_DEBUG=1
# Clave para firmar los JWT y los códigos. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_EXPIRES_MINUTES=60
# Orígenes permitidos por CORS (con el proxy de Vite no hace falta)
CORS_ORIGINS=http://localhost:5173

# ---------------- Sesión (cookie httpOnly) ----------------
# En producción con HTTPS: AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SECURE=false
# Lax si el FrontEnd se sirve en el mismo dominio (recomendado). None si está en otro dominio (requiere Secure).
AUTH_COOKIE_SAMESITE=Lax
# Días que dura la sesión con "Recordar mis datos"
REMEMBER_DAYS=30

# ---------------- Límite de intentos (login, registro, recuperación) ----------------
RATELIMIT_ENABLED=true
# memory:// sirve para un solo proceso. Con varios workers usa Redis: redis://localhost:6379
RATELIMIT_STORAGE_URI=memory://
# true si el BackEnd está detrás de nginx u otro proxy (para ver la IP real del cliente)
TRUST_PROXY=false

# ---------------- PostgreSQL (solo el BackEnd conoce esto) ----------------
# Recomendado: el usuario de mínimos privilegios milenew_app (database/scripts/02_app_role.sql)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=milenew
DATABASE_USER=
DATABASE_PASSWORD=
DB_POOL_ENABLED=true
DB_POOL_MAX=10

# ---------------- reCAPTCHA v2 ----------------
# Secreto que corresponde al VITE_RECAPTCHA_SITE_KEY del FrontEnd.
# Esta es la clave de PRUEBA oficial de Google (siempre aprueba); solo para desarrollo.
# Si se deja vacío, el BackEnd NO valida el captcha (solo desarrollo).
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# ---------------- Verificación en dos pasos y recuperación ----------------
TWO_FACTOR_ENABLED=false
AUTH_CODE_TTL_MINUTES=10
AUTH_CODE_MAX_ATTEMPTS=5

# ---------------- Correo (códigos 2FA / recuperación) ----------------
# Si MAIL_SERVER está vacío, los códigos se imprimen en la consola de Flask (desarrollo).
# Ejemplo con Gmail: MAIL_SERVER=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=tu correo y
# MAIL_PASSWORD = una "contraseña de aplicación" (myaccount.google.com/apppasswords), no tu clave normal.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Milenew <no-reply@milenew.local>

# ---------------- Simulación del bus (no hay GPS real todavía) ----------------
SIMULATION_SECONDS_PER_STOP=20
