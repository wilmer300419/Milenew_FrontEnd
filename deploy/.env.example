# Variables para docker compose:  docker compose --env-file deploy/.env up --build
# Genera claves con:  python -c "import secrets; print(secrets.token_hex(32))"
# (Usa solo letras y números en las contraseñas de la base.)

POSTGRES_PASSWORD=
APP_DB_PASSWORD=
SECRET_KEY=

# URL pública de la app (para CORS). En local: http://localhost:8080
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
# true cuando la app se sirve con HTTPS
AUTH_COOKIE_SECURE=false

# reCAPTCHA v2 INVISIBLE (claves de prueba de Google; cámbialas en producción)
VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# Correo para códigos de recuperación / 2FA (vacío = se imprimen en los logs de "api")
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Milenew <no-reply@milenew.local>
TWO_FACTOR_ENABLED=false
CONTACT_EMAIL=

# Crea pasajero@, conductor@ y central@milenew.co al arrancar (solo demos)
SEED_DEMO_USERS=true
